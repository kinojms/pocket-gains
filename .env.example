# Copy to .env.local for cloud mode. Leave unset to run in local mode (no login, no sync).
# Both values are public by design; data is protected by Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push public key (safe to share). Set by scripts/setup-vapid.mjs.
VITE_VAPID_PUBLIC_KEY=
